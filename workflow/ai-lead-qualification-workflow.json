        "messages": {
          "values": [
            {
              "content": "=You are an AI lead qualification system.\n\nAnalyze the business lead provided below.\n\nLead:\nName: {{ $json.body.name }}\nEmail: {{ $json.body.email }}\nCompany: {{ $json.body.company }}\nRequirement: {{ $json.body.requirement }}\nBudget: {{ $json.body.budget }}\n\nEvaluate the lead based only on the information provided.\n\nReturn ONLY valid JSON.\n\nThe JSON must contain exactly these four fields:\n\n{\n  \"lead_score\": number,\n  \"priority\": \"High\" or \"Medium\" or \"Low\",\n  \"requirement_summary\": \"short summary\",\n  \"recommended_action\": \"short recommended action\"\n}\n\nRules:\n- lead_score must be a number from 0 to 100.\n- priority must be exactly High, Medium, or Low.\n- requirement_summary must be concise.\n- recommended_action must be concise.\n- Do not include Markdown.\n- Do not include ```json.\n- Do not include explanations outside the JSON.\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        448,
        -96
      ],
      "id": "c265382a-de80-4d10-8cd9-ac467ef71c1d",
      "name": "Message a model",
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "WFWTv0TxFyWgjAx7",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Webhook').item.json.body;\nconst text = $json.content?.parts?.[0]?.text;\n\nif (!text) {\n  throw new Error('Gemini did not return a response.');\n}\n\nconst result = JSON.parse(text);\n\nreturn {\n  json: {\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    requirement: lead.requirement,\n    budget: lead.budget,\n    lead_score: result.lead_score,\n    priority: result.priority,\n    requirement_summary: result.requirement_summary,\n    recommended_action: result.recommended_action\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        -96
